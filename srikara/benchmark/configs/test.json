{
  "name": "test",
  "backend": "analytic",
  "random_source": "classical",
  "payload_bit_count": 12,
  "trials_per_combo": 2,
  "base_seed": 1000,
  "tolerance_sigmas": 1.0,
  "output_dir": "srikara/benchmark/results/test",
  "one_probabilities": [
    0.1,
    0.5,
    0.9
  ],
  "r_distributions": [
    {
      "kind": "uniform",
      "lower": 0.05,
      "upper": 0.2
    },
    {
      "kind": "fixed",
      "value": 0.4
    }
  ],
  "alpha_distribution": {
    "kind": "uniform_square",
    "bound": 2.0
  },
  "theta_distribution": {
    "kind": "uniform",
    "lower_pi": 0.0,
    "upper_pi": 2.0
  }
}
