{
  "name": "error_correction/noisy_disabled",
  "backend": "sf-noise",
  "noise": {
    "forward": [
      {"type": "thermal_loss", "transmittance": 0.95, "environment_nbar": 0.01}
    ],
    "return_path": [
      {"type": "thermal_loss", "transmittance": 0.95, "environment_nbar": 0.01}
    ],
    "alice_readout": [
      {"type": "electronic_noise", "variance_snu": 0.002}
    ],
    "bob_readout": [
      {"type": "electronic_noise", "variance_snu": 0.002}
    ]
  },
  "random_source": "classical",
  "payload_bit_count": 120,
  "trials_per_combo": 10,
  "base_seed": 20260822,
  "tolerance_sigmas": 3.0,
  "interval_policies": ["default"],
  "check_axis_policy": "random",
  "message_axis_policy": "optimized",
  "error_correction": "none",
  "one_probabilities": [0.5],
  "r_distributions": [{"kind": "uniform", "lower": 0.115, "upper": 0.576}],
  "alpha_distribution": {"kind": "uniform_square", "bound": 2.0},
  "theta_distribution": {
    "kind": "uniform",
    "lower_pi": 0.0,
    "upper_pi": 2.0
  }
}
