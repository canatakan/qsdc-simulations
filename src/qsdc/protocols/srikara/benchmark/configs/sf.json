      "upper": 0.2
    },
    {
      "kind": "uniform",
      "lower": 0.05,
      "upper": 0.4
    },
    {
      "kind": "uniform",
      "lower": 0.05,
      "upper": 0.8
    },
    {
      "kind": "uniform",
      "lower": 0.05,
      "upper": 1.2
